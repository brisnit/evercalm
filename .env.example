# ---------------------------------------------------------------------------
# EverCalm environment.
# Copy to .env.local for development. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public origin of the app. Used for auth callbacks and invitation links.
APP_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# DATABASE_URL is the APPLICATION RUNTIME role.
#   MUST be NOSUPERUSER and NOBYPASSRLS. Row-Level Security depends on it.
#   The app boots-checks this and refuses to start if the role can bypass RLS.
DATABASE_URL=postgres://evercalm_app:CHANGE_ME@localhost:5432/evercalm_dev

# MIGRATION_DATABASE_URL is a SEPARATE privileged role used only by
# `npm run db:migrate` and `npm run provision:organization`. It owns the
# tables and creates policies. It is never used to serve a request, and it is
# NEVER set on the web host (Vercel): migrations and provisioning run only
# from a trusted machine or a protected workflow.
# In production use the provider's DIRECT (unpooled) endpoint here.
MIGRATION_DATABASE_URL=postgres://evercalm_migrator:CHANGE_ME@localhost:5432/evercalm_dev

# Optional. Runtime connections per server instance. Defaults to 3 on Vercel
# (many instances share one database) and 10 elsewhere. In production point
# DATABASE_URL at the provider's POOLED (transaction-mode) endpoint.
# DATABASE_POOL_MAX=

# Optional. Integration tests use this if set; otherwise they boot a
# throwaway embedded PostgreSQL instance automatically (no Docker required).
# TEST_DATABASE_URL=

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars_openssl_rand_base64_32

# --- Email ----------------------------------------------------------------
# 'console' writes messages to stdout and sends nothing. Safe default.
# 'resend' requires RESEND_API_KEY and EMAIL_FROM on a verified sending
# domain the business owns (never a personal address, never a placeholder).
EMAIL_PROVIDER=console
EMAIL_FROM="EverCalm <no-reply@example.invalid>"
# RESEND_API_KEY=

# --- Billing ----------------------------------------------------------------
# 'mock'    development only: simulated provider events. Refused in production.
# 'manual'  a pilot with no payment provider: billing is arranged directly
#           with EverCalm, nothing is charged, owners cannot self-serve plan
#           changes, and only an EverCalm support administrator changes a
#           subscription's status. Allowed in production.
# See docs/runbooks/billing-provider.md.
BILLING_PROVIDER=mock
# Optional, development only: enables the signed mock webhook at
# /api/billing/webhook. Generate with: openssl rand -hex 32
# MOCK_BILLING_WEBHOOK_SECRET=

# --- Scheduled worker -------------------------------------------------------
# Vercel Cron calls GET /api/cron/worker with "Authorization: Bearer
# <CRON_SECRET>". Without it the endpoint answers 404 to everyone.
# Generate with: openssl rand -hex 32
# CRON_SECRET=

# --- Observability --------------------------------------------------------
LOG_LEVEL=info
