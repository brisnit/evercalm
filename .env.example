# ---------------------------------------------------------------------------
# EverCalm environment.
# Copy to .env.local for development. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public origin of the app. Used for auth callbacks and invitation links.
APP_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# DATABASE_URL is the APPLICATION RUNTIME role.
#   MUST be NOSUPERUSER and NOBYPASSRLS. Row-Level Security depends on it.
#   The app boots-checks this and refuses to start if the role can bypass RLS.
DATABASE_URL=postgres://evercalm_app:CHANGE_ME@localhost:5432/evercalm_dev

# MIGRATION_DATABASE_URL is a SEPARATE privileged role used only by
# `npm run db:migrate`. It owns the tables and creates policies.
# It is never used to serve a request.
MIGRATION_DATABASE_URL=postgres://evercalm_migrator:CHANGE_ME@localhost:5432/evercalm_dev

# Optional. Integration tests use this if set; otherwise they boot a
# throwaway embedded PostgreSQL instance automatically (no Docker required).
# TEST_DATABASE_URL=

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars_openssl_rand_base64_32

# --- Email ----------------------------------------------------------------
# 'console' writes messages to stdout and sends nothing. Safe default.
# 'resend' requires RESEND_API_KEY and a verified sending domain.
EMAIL_PROVIDER=console
EMAIL_FROM="EverCalm <no-reply@example.invalid>"
# RESEND_API_KEY=

# --- Billing ----------------------------------------------------------------
# Only the development-safe mock provider exists. It charges nothing and cannot
# serve production. See docs/runbooks/billing-provider.md for what a real
# provider needs.
BILLING_PROVIDER=mock
# Optional, development only: enables the signed mock webhook at
# /api/billing/webhook. Generate with: openssl rand -hex 32
# MOCK_BILLING_WEBHOOK_SECRET=

# --- Observability --------------------------------------------------------
LOG_LEVEL=info
